{
  "name": "DevShelf",
  "short_name": "DevShelf",
  "description": "Offline-first, keyboard-centric developer snippet manager",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1219",
  "theme_color": "#0f1219",
